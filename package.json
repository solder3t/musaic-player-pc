{
  "name": "musaic-player",
  "version": "0.5.4",
  "description": "Beautiful offline music player for Linux with lyrics, Listen Together, AI romanization & Last.fm",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run version:sync && node ./scripts/build/writeAppBuildMetadata.cjs && cross-env NODE_OPTIONS=\"--require ./scripts/node/polyfill-node18.cjs\" electron-vite dev",
    "build": "npm run version:sync && cross-env NODE_OPTIONS=\"--require ./scripts/node/polyfill-node18.cjs\" electron-vite build && node ./scripts/build/writeAppBuildMetadata.cjs",
    "build:icons": "node scripts/build/generate-musaic-icons.mjs",
    "preview": "cross-env NODE_OPTIONS=\"--require ./scripts/node/polyfill-node18.cjs\" electron-vite preview",
    "check:packaging-config": "node ./scripts/electron-builder/validate-config.cjs",
    "test": "node ./scripts/node/run-tests.cjs",
    "test:node": "node ./scripts/node/run-tests.cjs --node",
    "test:electron": "node ./scripts/node/run-tests.cjs --electron",
    "test:album-eligibility": "node --experimental-strip-types --experimental-default-type=module --test src/shared/library/albumEligibility.test.ts",
    "test:album-grouping": "node --experimental-strip-types --experimental-default-type=module --test src/shared/library/albumGrouping.test.ts",
    "test:artist-images": "node --experimental-strip-types --experimental-default-type=module --test src/shared/library/artistImages.test.ts",
    "test:library-latest-sync": "node --experimental-strip-types --experimental-default-type=module --test src/main/services/libraryLatestSync.test.ts",
    "test:library-sqlite": "cross-env ELECTRON_RUN_AS_NODE=1 electron --experimental-strip-types --loader ./scripts/node/electron-test-loader.mjs --test src/main/services/library.test.ts",
    "test:track-rating": "node --experimental-strip-types --test src/shared/ratings/trackRating.test.ts",
    "test:rating-calibration": "node --experimental-strip-types --test src/renderer/utils/ratingCalibration.test.ts",
    "test:library-integrity": "node --experimental-strip-types --experimental-default-type=module --loader ./scripts/node/resolve-ts-loader.mjs --test src/main/services/libraryIntegrity.test.ts",
    "test:lyrics-sidecar": "node --experimental-strip-types --experimental-default-type=module --loader ./scripts/node/resolve-ts-loader.mjs --test src/main/services/lyricsSidecar.test.ts",
    "test:library-graph": "node --experimental-strip-types --experimental-default-type=module --experimental-specifier-resolution=node --test src/renderer/utils/libraryGraph.test.ts",
    "test:renderer-library-store": "node --experimental-strip-types --experimental-default-type=module --loader ./scripts/node/resolve-ts-loader.mjs --test src/renderer/stores/libraryStore.test.ts",
    "test:renderer-player-store": "node --experimental-strip-types --loader ./scripts/node/resolve-ts-loader.mjs --test src/renderer/stores/playerStore.test.ts",
    "test:local-api": "node --experimental-strip-types --loader ./scripts/node/resolve-ts-loader.mjs --test src/main/services/localApi.test.ts",
    "test:companion-api": "node --experimental-strip-types --loader ./scripts/node/resolve-ts-loader.mjs --test src/main/services/companionApiRefs.test.ts src/main/services/companionApiContract.test.ts src/renderer/hooks/useCompanionApiBridge.test.ts",
    "test:companion-api-examples": "node --experimental-strip-types --loader ./scripts/node/resolve-ts-loader.mjs --test src/main/services/companionApiExamples.test.ts",
    "test:lastfm": "node --experimental-strip-types --experimental-default-type=module --loader ./scripts/node/resolve-ts-loader.mjs --test src/main/services/lastFm.test.ts",
    "test:phone-remote": "node --experimental-strip-types --loader ./scripts/node/resolve-ts-loader.mjs --test src/main/services/phoneRemote.test.ts src/shared/sync/conflictPreview.test.ts",
    "test:activity-indicator": "node --experimental-strip-types --experimental-default-type=module --experimental-specifier-resolution=node --test src/renderer/utils/musaicActivity.test.ts",
    "test:audio-loudness": "node --experimental-strip-types --experimental-default-type=module --loader ./scripts/node/resolve-ts-loader.mjs --test src/renderer/audio/loudness.test.ts",
    "test:spectrum-native": "node --test native/test/spectrum-bars.test.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:receiver": "tsc --noEmit -p receiver/tsconfig.json",
    "receiver:dev": "node --experimental-strip-types --loader ./scripts/node/resolve-ts-loader.mjs receiver/src/main.ts",
    "receiver:build": "vite build --config receiver/vite.config.ts",
    "receiver:native": "cd receiver/native && node-gyp rebuild",
    "build:native": "cd native && node-gyp rebuild",
    "rebuild:musaic-native": "node -e \"const e=require('electron/package.json').version;const a=process.arch;const{execSync}=require('child_process');execSync('node-gyp rebuild --target='+e+' --arch='+a+' --dist-url=https://electronjs.org/headers',{stdio:'inherit',cwd:'native'})\"",
    "rebuild:better-sqlite3": "node -e \"const e=require('electron/package.json').version;const a=process.arch;const{execSync}=require('child_process');execSync('node-gyp rebuild --target='+e+' --arch='+a+' --dist-url=https://electronjs.org/headers',{stdio:'inherit',cwd:'node_modules/better-sqlite3'})\"",
    "rebuild:native": "npm run rebuild:musaic-native && npm run rebuild:better-sqlite3",
    "postinstall": "npm run version:sync && (npm run rebuild:native || echo 'Native rebuild failed, app may use fallbacks or database access may fail')",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "version:sync": "node ./scripts/build/sync-version.cjs",
    "version": "node ./scripts/build/sync-version.cjs && git add .github/aur/PKGBUILD .github/homebrew/musaic-player.rb package-lock.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/solder3t/musaic-player-linux"
  },
  "keywords": [
    "music",
    "player",
    "audio",
    "visualizer",
    "electron"
  ],
  "author": {
    "name": "solder3t",
    "email": "sold3vs@gmail.com"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "@boof2015/astra-signal": "0.3.0",
    "@boof2015/xlrc": "^0.2.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@material/material-color-utilities": "^0.4.0",
    "@peculiar/x509": "^2.0.0",
    "better-sqlite3": "^12.10.0",
    "bonjour-service": "^1.4.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "music-metadata": "^11.12.3",
    "node-addon-api": "^8.7.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-window": "^2.2.7",
    "reflect-metadata": "^0.2.2",
    "undici": "^8.7.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "electron": "^40.10.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "node-gyp": "^12.3.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.3"
  },
  "build": {
    "appId": "com.musaic.mp",
    "productName": "Musaic Player",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "afterPack": "./scripts/electron-builder/afterPack-prune-ffprobe.cjs",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**",
      "node_modules/better-sqlite3/**"
    ],
    "files": [
      "out/**/*",
      ".env.local",
      "native/build/Release/*.node",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "extraResources": [
      {
        "from": "native/build/Release/",
        "to": "native/",
        "filter": [
          "*.node"
        ]
      },
      {
        "from": "THIRD_PARTY_LICENSES.md",
        "to": "THIRD_PARTY_LICENSES.md"
      }
    ],
    "win": {
      "fileAssociations": [
        {
          "name": "Musaic Audio File",
          "description": "Audio file",
          "role": "Viewer",
          "ext": [
            "mp3",
            "flac",
            "wav",
            "ogg",
            "aac",
            "m4a",
            "opus",
            "wma",
            "aiff",
            "alac",
            "ape",
            "wv"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "mac": {
      "fileAssociations": [
        {
          "name": "Musaic Audio File",
          "description": "Audio file",
          "role": "Viewer",
          "ext": [
            "mp3",
            "flac",
            "wav",
            "ogg",
            "aac",
            "m4a",
            "opus",
            "wma",
            "aiff",
            "alac",
            "ape",
            "wv"
          ]
        }
      ],
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Musaic-${version}-Mac-${arch}.${ext}",
      "icon": "resources/icon.icns",
      "category": "public.app-category.music",
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.inherit.plist"
    },
    "linux": {
      "fileAssociations": [
        {
          "name": "Musaic Audio File",
          "description": "Audio file",
          "ext": "mp3"
        },
        {
          "name": "Musaic Audio File",
          "description": "Audio file",
          "ext": "flac"
        },
        {
          "name": "Musaic Audio File",
          "description": "Audio file",
          "ext": "wav"
        },
        {
          "name": "Musaic Audio File",
          "description": "Audio file",
          "ext": "ogg"
        },
        {
          "name": "Musaic Audio File",
          "description": "Audio file",
          "ext": "aac"
        },
        {
          "name": "Musaic Audio File",
          "description": "Audio file",
          "ext": "m4a"
        },
        {
          "name": "Musaic Audio File",
          "description": "Audio file",
          "ext": "opus"
        },
        {
          "name": "Musaic Audio File",
          "description": "Audio file",
          "ext": "wma"
        },
        {
          "name": "Musaic Audio File",
          "description": "Audio file",
          "ext": "aiff"
        },
        {
          "name": "Musaic Audio File",
          "description": "Audio file",
          "ext": "alac"
        },
        {
          "name": "Musaic Audio File",
          "description": "Audio file",
          "ext": "ape"
        },
        {
          "name": "Musaic Audio File",
          "description": "Audio file",
          "ext": "wv"
        }
      ],
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz"
      ],
      "artifactName": "Musaic-${version}-Linux-${arch}.${ext}",
      "category": "Audio",
      "icon": "build/icon.png"
    },
    "appImage": {
      "artifactName": "Musaic-${version}-Linux.${ext}"
    },
    "dmg": {
      "background": "resources/background.png",
      "iconSize": 80,
      "iconTextSize": 12,
      "window": {
        "width": 540,
        "height": 440
      },
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Musaic.Setup.${version}.Windows.${ext}"
    },
    "portable": {
      "artifactName": "Musaic.Portable.${version}.Windows.${ext}"
    }
  }
}
