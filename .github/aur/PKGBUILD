# Maintainer: solder3t <adityasikarwar573@gmail.com>
pkgname=musaic-player-bin
pkgver=0.4.0.beta
pkgrel=1
pkgdesc="Audiophile music player with advanced visualization"
arch=('x86_64')
url="https://github.com/solder3t/musaic-player-linux"
license=('GPL-3.0-only')
provides=('musaic')
conflicts=('musaic')
depends=('fuse2')
options=(!strip !debug)
source=("musaic-0.4.0.beta.AppImage::https://github.com/solder3t/musaic-player-linux/releases/download/v0.4.0-beta/Musaic-0.4.0-beta-Linux.AppImage")
noextract=("musaic-${pkgver}.AppImage")
sha256sums=('SKIP')

prepare() {
  cd "${srcdir}"

  chmod +x "musaic-${pkgver}.AppImage"
  rm -rf squashfs-root
  "./musaic-${pkgver}.AppImage" --appimage-extract >/dev/null
}

package() {
  local _appdir="${srcdir}/squashfs-root"
  local _appimage_source="${srcdir}/musaic-${pkgver}.AppImage"
  local _appimage_target="${pkgdir}/opt/musaic/musaic.AppImage"
  local _desktop_path="${pkgdir}/usr/share/applications/musaic.desktop"
  local _desktop_source
  local _icon_source
  local _icon_relative
  local _icon_ext
  local _icon_installed=0
  local _root_icon

  install -Dm755 "${_appimage_source}" "${_appimage_target}"

  install -dm755 "${pkgdir}/usr/bin"
  printf '%s\n' '#!/bin/sh' 'exec /opt/musaic/musaic.AppImage --no-sandbox "$@"' > "${pkgdir}/usr/bin/musaic"
  chmod 755 "${pkgdir}/usr/bin/musaic"

  _desktop_source="$(find "${_appdir}" -type f -iname '*.desktop' | LC_ALL=C sort | head -n 1)"
  if [[ -z "${_desktop_source}" ]]; then
    echo "No desktop file found in extracted AppImage." >&2
    return 1
  fi

  install -dm755 "${pkgdir}/usr/share/applications"
  sed \
    -e 's|^Exec=.*|Exec=musaic %U|' \
    -e 's|^TryExec=.*|TryExec=musaic|' \
    -e 's|^Icon=.*|Icon=musaic|' \
    "${_desktop_source}" > "${_desktop_path}"

  if ! grep -q '^TryExec=' "${_desktop_path}"; then
    sed -i '/^Exec=musaic %U$/a TryExec=musaic' "${_desktop_path}"
  fi

  if ! grep -q '^Icon=' "${_desktop_path}"; then
    sed -i '/^\[Desktop Entry\]$/a Icon=musaic' "${_desktop_path}"
  fi

  if [[ -d "${_appdir}/usr/share/icons/hicolor" ]]; then
    while IFS= read -r -d '' _icon_source; do
      _icon_relative="${_icon_source#${_appdir}/usr/share/icons/hicolor/}"
      _icon_relative="${_icon_relative%/*}"
      _icon_ext="${_icon_source##*.}"
      install -Dm644 \
        "${_icon_source}" \
        "${pkgdir}/usr/share/icons/hicolor/${_icon_relative}/apps/musaic.${_icon_ext}"
      _icon_installed=1
    done < <(
      find "${_appdir}/usr/share/icons/hicolor" \
        -type f \
        \( -iname '*.png' -o -iname '*.svg' \) \
        -path '*/apps/*' \
        -print0
    )
  fi

  if (( !_icon_installed )); then
    _root_icon="$(find "${_appdir}" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.svg' \) | LC_ALL=C sort | head -n 1)"
    if [[ -z "${_root_icon}" ]]; then
      echo "No icon assets found in extracted AppImage." >&2
      return 1
    fi

    _icon_ext="${_root_icon##*.}"
    install -Dm644 \
      "${_root_icon}" \
      "${pkgdir}/usr/share/icons/hicolor/512x512/apps/musaic.${_icon_ext}"
  fi
}
